                  ],
                  "properties": {
                    "contribution": {
                      "type": "string",
                      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$"
                    },
                    "contribution_type": {
                      "enum": [
                        "member_cost",
                        "employer_cost",
                        "employer_percentage",
                        "flat_employer_cost",
                        "flat_employer_percentage",
                        "employer_match",
                        "member_income_percentage"
                      ]
                    },
                    "monthly_min_threshold": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$"
                    },
                    "monthly_max_threshold": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
